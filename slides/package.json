{
  "name": "webdeck",
  "private": true,
  "version": "1.0.16",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && SINGLEFILE=1 vite build --outDir dist-single && mv dist-single/index.html dist-single/WebDeck.webdeck.html && node ../scripts/postbuild-compress.mjs dist-single/WebDeck.webdeck.html",
    "preview": "vite preview"
  },
  "dependencies": {
    "moveable": "^0.53.0",
    "pptxgenjs": "^4.0.1",
    "reveal.js": "^5.2.1",
    "selecto": "^1.26.3",
    "temml": "^0.13.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/reveal.js": "^5.2.1",
    "fake-indexeddb": "^6.2.5",
    "qrcode": "^1.5.4",
    "typescript": "~5.8.3",
    "vite": "^7.1.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
